create_clock [get_ports clk]  -name xu_clk  -period 6.66667  -waveform {0 3.33333}
set_clock_uncertainty 0.1  [get_clocks xu_clk]
set_clock_transition -max -rise 0.1 [get_clocks xu_clk]
set_clock_transition -max -fall 0.1 [get_clocks xu_clk]
set_clock_transition -min -rise 0.1 [get_clocks xu_clk]
set_clock_transition -min -fall 0.1 [get_clocks xu_clk]
set_false_path   -from [get_ports rst_n]
