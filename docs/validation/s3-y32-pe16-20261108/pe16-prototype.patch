+++ b/src/main/scala/linear/PairComputeCore.scala
@@ -0,0 +1,66 @@
+package linear
+
+import chisel3._
+import chisel3.util.Cat
+import dotproduct.DotProductEngine
+import memory.{Sram1024x16, XRowBuffer}
+
+class PairComputeCoreIO extends LinearComputeCoreIO {
+    val biasHi = Input(Vec(8, SInt(40.W)))
+    val resultHi = Output(Vec(8, SInt(48.W)))
+}
+
+/** Experimental sixteen-PE core. Upload addresses retain the eight-bank ABI.
+  * Each original bank's two SRAMs now hold even/odd groups, respectively;
+  * removing logical address bit six gives a ten-bit physical SRAM address.
+  * Both SRAMs are read in parallel, with no extra weight storage or read ports.
+  */
+class PairComputeCore extends Module {
+    val io = IO(new PairComputeCoreIO)
+    private val xBuffer = Module(new XRowBuffer)
+    private val engine = Module(new DotProductEngine)
+    private val engineHi = Module(new DotProductEngine)
+    private val memories = Seq.fill(8, 2)(Module(new Sram1024x16))
+    private val groupHi = (io.group + 1.U)(4, 0)
+    private val lowAddr = Cat(io.group(4, 1), engine.io.weightReadK)
+    private val highAddr = Cat(groupHi(4, 1), engineHi.io.weightReadK)
+    private val writeAddr = Cat(io.wLoadAddr(10, 7), io.wLoadAddr(5, 0))
+
+    xBuffer.io.wen := io.xLoadWen
+    xBuffer.io.waddr := io.xLoadAddr
+    xBuffer.io.wdata := io.xLoadData
+    xBuffer.io.raddr := engine.io.k
+    engine.io.start := io.start
+    engineHi.io.start := io.start
+    engine.io.x := xBuffer.io.rdata
+    engineHi.io.x := xBuffer.io.rdata
+    engine.io.bias := io.bias
+    engineHi.io.bias := io.biasHi
+
+    private val delayedOdd = RegNext(io.group(0), false.B)
+    for (lane <- 0 until 8) {
+        for (parity <- 0 until 2) {
+            val memory = memories(lane)(parity)
+            val write = io.wLoadWen && io.wLoadBank === lane.U &&
+                io.wLoadAddr(6) === (parity == 1).B
+            val low = io.group(0) === (parity == 1).B
+            val readEnable = Mux(low, engine.io.weightRen, engineHi.io.weightRen)
+            assert(!(write && readEnable), "Pair weight SRAM read/write overlap")
+            memory.io.en := write || readEnable
+            memory.io.isWrite := write
+            memory.io.addr := Mux(write, writeAddr, Mux(low, lowAddr, highAddr))
+            memory.io.wdata := io.wLoadData
+        }
+        engine.io.w(lane) := Mux(delayedOdd, memories(lane)(1).io.rdata,
+            memories(lane)(0).io.rdata)
+        engineHi.io.w(lane) := Mux(delayedOdd, memories(lane)(0).io.rdata,
+            memories(lane)(1).io.rdata)
+    }
+    assert(engine.io.k === engineHi.io.k)
+    assert(engine.io.weightRen === engineHi.io.weightRen)
+    assert(engine.io.weightReadK === engineHi.io.weightReadK)
+    assert(engine.io.done === engineHi.io.done)
+    io.done := engine.io.done
+    io.result := engine.io.result
+    io.resultHi := engineHi.io.result
+}
