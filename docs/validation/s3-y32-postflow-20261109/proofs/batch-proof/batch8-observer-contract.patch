+def check_batch16_activity(log, layers, schedule):
+    names = ['layer', 'requests', 'snapshots', 'pops_retired', 'blocks_written',
+             'lanes', 'no_write_before_both_pops']
+    pattern = r'^BATCH16_TASK ' + ' '.join(name+r'=(\d+)' for name in names) + r'$'
+    records = [dict(zip(names, map(int, row))) for row in re.findall(pattern, log, re.M)]
+    expected = len(layers) if schedule == contract.NICE_BATCH16_SCHEDULE else 0
+    if len(records) != expected or len(records) != len(re.findall(r'^BATCH16_TASK\b', log, re.M)):
+        raise ValueError('missing, duplicate, malformed or unexpected batch16 activity')
+    for record, layer in zip(records, layers):
+        if record != dict(layer=layer['layer'], requests=1584, snapshots=3168,
+                          pops_retired=3168, blocks_written=1584, lanes=25344,
+                          no_write_before_both_pops=1):
+            raise ValueError('batch16 dual-bundle/POP/write coverage differs')
+    return records
+
+
+def check_pe16_activity(log, layers, schedule):
+    """Require independently observed physical controls on both eight-PE engines."""
+    names = ['layer', 'pes', 'engines', 'physical_groups', 'physical_mac_cycles',
+             'logical_macs', 'lo_starts', 'hi_starts', 'lo_init', 'hi_init',
+             'lo_mac_fire', 'hi_mac_fire', 'lo_done', 'hi_done', 'checked_cycles',
+             'sync_errors']
+    pattern = r'^PE16_TASK ' + ' '.join(name+r'=(\d+)' for name in names) + r'$'
+    records = [dict(zip(names, map(int, row))) for row in re.findall(pattern, log, re.M)]
+    expected = len(layers) if contract.PES == 16 and schedule in contract.DIRECT_SCHEDULES else 0
+    if len(records) != expected or len(records) != len(re.findall(r'^PE16_TASK\b', log, re.M)):
+        raise ValueError('missing, duplicate, malformed or unexpected physical 16-PE activity')
+    for record, layer in zip(records, layers):
+        if record != dict(layer=layer['layer'], pes=16, engines=2,
+                          physical_groups=1584, physical_mac_cycles=101376,
+                          logical_macs=contract.MACS_PER_TASK,
+                          lo_starts=1584, hi_starts=1584, lo_init=1584, hi_init=1584,
+                          lo_mac_fire=101376, hi_mac_fire=101376,
+                          lo_done=1584, hi_done=1584, checked_cycles=layer['cycles'],
+                          sync_errors=0):
+            raise ValueError('physical 16-PE lane work or synchronized control coverage differs')
+    return records
+
+def check_pe8_activity(log, layers, schedule):
+    names=['layer','pes','physical_groups','physical_mac_cycles','logical_macs','checked_cycles']
+    pattern=r'^PE8_TASK '+' '.join(name+r'=(\d+)' for name in names)+r'$'
+    records=[dict(zip(names,map(int,row))) for row in re.findall(pattern,log,re.M)]
+    expected=len(layers) if contract.PES==8 and schedule in contract.DIRECT_SCHEDULES else 0
+    if len(records)!=expected or len(records)!=len(re.findall(r'^PE8_TASK\b',log,re.M)):
+        raise ValueError('missing, malformed or unexpected physical eight-PE activity')
+    for record,layer in zip(records,layers):
+        if record!=dict(layer=layer['layer'],pes=8,physical_groups=3168,
+                        physical_mac_cycles=202752,logical_macs=1622016,checked_cycles=layer['cycles']):
+            raise ValueError('physical eight-PE work coverage differs')
+    return records
