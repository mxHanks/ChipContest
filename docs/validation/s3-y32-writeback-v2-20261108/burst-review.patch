+"""Optional drainN transport: explicit ABI, unchanged payload and old drain8 ABI."""
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+sys.path.insert(0, str(Path(__file__).resolve().parents[2] / 'tools/scripts'))
+import xu_firmware_contract as contract
+import e203_soc as soc
+
+class DrainNTests(unittest.TestCase):
+    def test_explicit_schedule_changes_instruction_count_only(self):
+        old=contract.NICE_READ_POP_SCHEDULE;new=contract.NICE_DRAIN_N_SCHEDULE
+        self.assertEqual(contract.task_contract(new), {**contract.task_contract(old),
+            'nice_requests':99,'nice_responses':99,'nice_oitf_retired':99})
+        old_flags=contract.compiler_defines(contract.configuration(old))
+        self.assertNotIn('-DXU_NICE_DRAIN_N=1',old_flags)
+        self.assertEqual(contract.compiler_defines(contract.configuration(new)),old_flags+['-DXU_NICE_DRAIN_N=1'])
+        self.assertEqual(contract.simulator_arguments(new),contract.simulator_arguments(old)+['+NICE_DRAIN_N=1'])
+        layers=[dict(layer=0,cycles=1000000)]
+        log=('NICE_TASK layer=0 requests=99 responses=99 oitf_retired=99 status_polls=3168 '
+             'result_reads=25344 pops_retired=3168 shared_writes=25344\n')
+        self.assertEqual(soc.check_nice_activity(log,layers,new)[0]['requests'],99)
+        for invalid in [log.replace('requests=99','requests=3168'),
+                        log.replace('oitf_retired=99','oitf_retired=98'),
+                        log.replace('pops_retired=3168','pops_retired=99'),
+                        log.replace('result_reads=25344','result_reads=25343')]:
+            with self.assertRaises(ValueError): soc.check_nice_activity(invalid,layers,new)
+        with self.assertRaises(ValueError): soc.check_nice_activity(log,layers,old)
+        self.assertEqual(soc.check_read_pop_activity('READ_POP_TASK layer=0 alias_reads=3168 explicit_pops=0\n',layers,new)[0]['alias_reads'],3168)
+
+    def test_state_machine_conservation_bounds_errors_and_backpressure(self):
+        root=Path(__file__).resolve().parents[2];rtl=root/'third-party/e203_hbirdv2/rtl/e203'
+        with tempfile.TemporaryDirectory() as directory:
+            binary=Path(directory)/'drainN.vvp'
+            compiled=subprocess.run(['iverilog','-g2012','-I'+str(rtl/'core'),'-s','tb_nice_drainN','-o',str(binary),
+                str(root/'experiments/nice_reachability/tb_nice_drainN.sv'),str(rtl/'subsys/xu_nice_drain8.v')],capture_output=True,text=True,timeout=30)
+            self.assertEqual(compiled.returncode,0,compiled.stderr)
+            result=subprocess.run(['vvp',str(binary)],capture_output=True,text=True,timeout=30)
+            self.assertEqual(result.returncode,0,result.stdout+result.stderr)
+            self.assertIn('NICE_DRAIN_N_UNIT_PASS cases=79 commands=10617 responses=10617',result.stdout)
+
+if __name__=='__main__': unittest.main()
