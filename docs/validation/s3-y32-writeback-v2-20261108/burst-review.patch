+      if (!rsp_valid) $fatal(1,"completion disappeared at retirement");
+      @(negedge clk);
+      rsp_ready=0;
+      if (!req_ready || rsp_valid || cmd_valid || hold) $fatal(1,"DUT failed to return idle");
